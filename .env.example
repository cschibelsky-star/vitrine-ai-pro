APP_NAME="Vitrine AI Pro"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=pt_BR
APP_FAKER_LOCALE=pt_BR

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=vitrine_ai_pro
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=public

MAIL_MAILER=log
MAIL_FROM_ADDRESS="contato@vitrineiapro.com.br"
MAIL_FROM_NAME="${APP_NAME}"

# Chave privada usada somente por formulários processados no servidor.
# Gere com: php -r "echo bin2hex(random_bytes(32)), PHP_EOL;"
LEAD_CAPTURE_KEY=
LEAD_CAPTURE_REQUIRE_CONSENT=true

# Centro IA — API interna compartilhada entre produtos da Vitrine IA Pro.
# Nunca versionar o token real. Gere um segredo forte no ambiente do Core.
CENTRO_IA_INTERNAL_TOKEN=

# Capability usada pelo Cursos IA MVP.
# Configure por ID ou slug de um agente já cadastrado no Centro IA.
CENTRO_IA_COURSE_GENERATION_AGENT_ID=
CENTRO_IA_COURSE_GENERATION_AGENT_SLUG=

# Google Cloud / Vertex AI — opt-in. Mantém Gemini AI Studio separado do crédito GCP.
# Não versionar tokens, JSON de service account ou outros segredos.
VERTEX_AI_ENABLED=false
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_APPLICATION_CREDENTIALS=
GOOGLE_VERTEX_ACCESS_TOKEN=
GOOGLE_VERTEX_IMAGE_MODEL=imagen-4.0-generate-001
GOOGLE_VERTEX_VIDEO_MODEL=veo-3.0-generate-001
GOOGLE_VERTEX_VIDEO_GCS_URI=
