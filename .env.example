APP_NAME="Vitrine AI Pro"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=pt_BR
APP_FAKER_LOCALE=pt_BR

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=vitrine_ai_pro
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=public

MAIL_MAILER=log
MAIL_FROM_ADDRESS="contato@vitrineaipro.com.br"
MAIL_FROM_NAME="${APP_NAME}"

# Chave privada usada somente por formulários processados no servidor.
# Gere com: php -r "echo bin2hex(random_bytes(32)), PHP_EOL;"
LEAD_CAPTURE_KEY=
LEAD_CAPTURE_REQUIRE_CONSENT=true

# Centro IA — API interna compartilhada entre produtos da Vitrine IA Pro.
# Nunca versionar o token real. Gere um segredo forte no ambiente do Core.
CENTRO_IA_INTERNAL_TOKEN=

# Capability usada pelo Cursos IA MVP.
# Configure por ID ou slug de um agente já cadastrado no Centro IA.
CENTRO_IA_COURSE_GENERATION_AGENT_ID=
CENTRO_IA_COURSE_GENERATION_AGENT_SLUG=

# Marketing IA — Video Producer / Gemini Veo 3.1.
# Nunca versionar GEMINI_API_KEY. Em HML, a chave fica no .env.runtime protegido.
MARKETING_VIDEO_PROVIDER=gemini_veo
GEMINI_API_KEY=
GEMINI_VEO_MODEL=veo-3.1-generate-preview
GEMINI_VEO_ASPECT_RATIO=9:16
GEMINI_VEO_RESOLUTION=720p
GEMINI_VEO_DURATION_SECONDS=8
GEMINI_VEO_POLL_INTERVAL=10
GEMINI_VEO_MAX_WAIT=360
