APP_NAME="Vitrine AI Pro"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=pt_BR
APP_FAKER_LOCALE=pt_BR

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=vitrine_ai_pro
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=public

MAIL_MAILER=log
MAIL_FROM_ADDRESS="contato@vitrineiapro.com.br"
MAIL_FROM_NAME="${APP_NAME}"

# Chave privada usada somente por formulários processados no servidor.
# Gere com: php -r "echo bin2hex(random_bytes(32)), PHP_EOL;"
LEAD_CAPTURE_KEY=
LEAD_CAPTURE_REQUIRE_CONSENT=true

# Centro IA — API interna compartilhada entre produtos da Vitrine IA Pro.
# Nunca versionar o token real. Gere um segredo forte no ambiente do Core.
CENTRO_IA_INTERNAL_TOKEN=

# Capability usada pelo Cursos IA MVP.
# Configure por ID ou slug de um agente já cadastrado no Centro IA.
CENTRO_IA_COURSE_GENERATION_AGENT_ID=
CENTRO_IA_COURSE_GENERATION_AGENT_SLUG=


# Hub IA / Roteia — gateway preferencial quando configurado.
# Nunca versionar credenciais reais; preencher somente no ambiente local/secret store.
ROTEIA_BASE_URL=
ROTEIA_API_KEY=

# --- Escritório Virtual — execução de IA dos agentes --------------------------
# ⭐ As chaves e o endpoint são os MESMOS do Centro IA (ROTEIA_BASE_URL e
# ROTEIA_API_KEY, acima). Não crie uma segunda chave para o mesmo provedor: o
# dia que uma acabar e a outra não, o produto quebra de um jeito difícil de
# diagnosticar.
ROTEIA_CHAT_MODEL=

# ⭐ A LISTA DE MODELOS é o que liga a execução. Sem ela, nenhuma chamada de IA
# acontece — mesmo com a chave no ambiente. É o estado correto enquanto se
# avalia fluxo e custo: o Escritório e a supervisão da VIA rodam sem gastar.
ESCRITORIO_IA_MODELOS=
ESCRITORIO_MODEL_PADRAO=
