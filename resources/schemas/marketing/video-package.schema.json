{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vitrineaipro.com.br/schemas/marketing/video-package-v1.json",
  "title": "Video Package",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "video_package_id",
    "videos",
    "status"
  ],
  "properties": {
    "video_package_id": {
      "type": "string",
      "minLength": 1
    },
    "videos": {
      "type": "array"
    },
    "voice_requirements": {
      "type": "object"
    },
    "render_requirements": {
      "type": "object"
    },
    "missing_assets": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "status": {
      "const": "completed"
    }
  }
}
