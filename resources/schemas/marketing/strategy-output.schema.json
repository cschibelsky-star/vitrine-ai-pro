{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vitrineaipro.com.br/schemas/marketing/strategy-output-v1.json",
  "title": "Strategy Output",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "strategy_id",
    "campaign_id",
    "product_readiness",
    "icp",
    "pain_points",
    "value_proposition",
    "positioning",
    "differentiators",
    "core_message",
    "status"
  ],
  "properties": {
    "strategy_id": {
      "type": "string",
      "minLength": 1
    },
    "campaign_id": {
      "type": "string",
      "minLength": 1
    },
    "product_readiness": {
      "type": "object"
    },
    "icp": {
      "type": "array"
    },
    "personas": {
      "type": "array"
    },
    "pain_points": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "desired_outcomes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "value_proposition": {
      "type": "string",
      "minLength": 1
    },
    "positioning": {
      "type": "string",
      "minLength": 1
    },
    "differentiators": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "objections": {
      "type": "array"
    },
    "core_message": {
      "type": "string",
      "minLength": 1
    },
    "campaign_concept": {
      "type": "string",
      "minLength": 1
    },
    "recommended_channels": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "open_questions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "status": {
      "const": "completed"
    }
  }
}
