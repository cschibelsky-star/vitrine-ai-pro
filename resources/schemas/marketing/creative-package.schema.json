{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vitrineaipro.com.br/schemas/marketing/creative-package-v1.json",
  "title": "Creative Package",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "creative_package_id",
    "visual_direction",
    "assets",
    "status"
  ],
  "properties": {
    "creative_package_id": {
      "type": "string",
      "minLength": 1
    },
    "visual_direction": {
      "type": "object"
    },
    "assets": {
      "type": "array"
    },
    "template_definitions": {
      "type": "array"
    },
    "missing_assets": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "status": {
      "const": "completed"
    }
  }
}
